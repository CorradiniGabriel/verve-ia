# Banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/contabil_ia

# JWT — gere uma chave aleatória longa (ex: openssl rand -base64 32)
JWT_SECRET=sua_chave_secreta_aqui

# Claude API (opcional — necessário para sugestões de IA)
ANTHROPIC_API_KEY=sk-ant-...

# URL do frontend (para CORS)
FRONTEND_URL=https://seuusuario.github.io

# Ambiente
NODE_ENV=production
PORT=3001
